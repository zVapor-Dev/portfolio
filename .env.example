# ─── Database (required for CMS) ───────────────────────────────────────────
# Any PostgreSQL database. POSTGRES_URL is accepted as an alias.
# `npm run build` runs `payload migrate` before `next build` (requires DATABASE_URL + PAYLOAD_SECRET).
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
# POSTGRES_URL=postgresql://user:password@localhost:5432/portfolio

# ─── Payload CMS (required) ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=
PREVIEW_SECRET=your-preview-secret-for-live-preview

# Public site URL (used for live preview, metadata, and admin "View live site" link)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Seeding CMS content ─────────────────────────────────────────────────────
# See docs/SEED.md for production seeding steps.
# npm run migrate && npm run seed

# ─── Admin password reset ────────────────────────────────────────────────────
# ADMIN_EMAIL and ADMIN_PASSWORD are read only by scripts/reset-admin-password.ts
# (updates an existing user). Set them in your shell for a single run; never
# commit them or add them to the deployment environment.

# ─── SMTP contact form ─────────────────────────────────────────────────────
# Build succeeds without SMTP_PASSWORD; contact form returns 503 until configured.
SMTP_HOST=mail.zvapor.xyz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@zvapor.xyz
SMTP_PASSWORD=
SMTP_FROM=noreply@zvapor.xyz
CONTACT_TO=contact@zvapor.xyz

# Optional contact form rate limit (default: 5 requests per hour per IP + per email)
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=3600000

# Upstash Redis (optional; keeps rate limits across restarts)
# Free tier: https://upstash.com — create a Redis database and paste REST credentials.
# When unset, the contact API falls back to an in-memory limiter in the server process.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
