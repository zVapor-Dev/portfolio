# ─── Database (required for CMS) ───────────────────────────────────────────
# Create a free Neon Postgres database at https://neon.tech
# Use the pooled connection string as DATABASE_URL or POSTGRES_URL.
# Vercel builds run `payload migrate` before `next build` (requires DATABASE_URL + PAYLOAD_SECRET).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# POSTGRES_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ─── Payload CMS (required) ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=
PREVIEW_SECRET=your-preview-secret-for-live-preview

# Public site URL (used for live preview, metadata, and admin "View live site" link)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Seeding CMS content ─────────────────────────────────────────────────────
# See docs/SEED.md for production seeding steps.
# npm run migrate && npm run seed

# ─── SMTP contact form ─────────────────────────────────────────────────────
# Build succeeds without SMTP_PASSWORD; contact form returns 503 until configured.
SMTP_HOST=mail.zvapor.xyz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@zvapor.xyz
SMTP_PASSWORD=
SMTP_FROM=noreply@zvapor.xyz
CONTACT_TO=contact@zvapor.xyz

# Optional contact form rate limit (per client IP; in-memory on each serverless instance)
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=900000
