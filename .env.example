# ─── Database (required for CMS) ───────────────────────────────────────────
# Create a free Neon Postgres database at https://neon.tech
# Use the pooled connection string as DATABASE_URL or POSTGRES_URL.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# POSTGRES_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ─── Payload CMS ─────────────────────────────────────────────────────────────
PAYLOAD_SECRET=your-random-secret-at-least-32-chars
PREVIEW_SECRET=your-preview-secret-for-live-preview

# Public site URL (used for live preview + metadata)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── SMTP contact form ─────────────────────────────────────────────────────
# Build succeeds without SMTP_PASSWORD; contact form returns 503 until configured.
SMTP_HOST=mail.zvapor.xyz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@zvapor.xyz
SMTP_PASSWORD=
SMTP_FROM=noreply@zvapor.xyz
CONTACT_TO=contact@zvapor.xyz
